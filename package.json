{
  "name": "plainscore",
  "version": "0.2.0",
  "description": "A plain-text score format a musician can read and an AI can edit, with MIDI and ABC export.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innei/plainscore.git"
  },
  "homepage": "https://github.com/Innei/plainscore#readme",
  "keywords": [
    "music",
    "score",
    "notation",
    "abc",
    "midi",
    "dsl",
    "composer"
  ],
  "type": "module",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "plainscore": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./abc": "./dist/abc/index.js",
    "./midi": "./dist/midi.js",
    "./legend": "./dist/legend.js"
  },
  "files": [
    "dist",
    "docs/grammar.md",
    "llms.txt"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
