{
  "name": "plainscore-render",
  "version": "0.1.0",
  "description": "Render a plainscore .score to a mastered WAV: stems, mix, space, section loudness and a true-peak limiter, the same in Node and the browser.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Innei/plainscore.git",
    "directory": "packages/render"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "plainscore-render": "./dist/node/bin.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./live": "./dist/live.js",
    "./node": "./dist/node/index.js"
  },
  "files": [
    "dist",
    "mixer"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && vite build --config web/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "dev": "vite --config web/vite.config.ts",
    "build:site": "vite build --config web/vite.config.ts --mode site",
    "dev:site": "vite --config web/vite.config.ts --mode site",
    "site:assets": "node scripts/fetch-sounds.mjs"
  },
  "dependencies": {
    "plainscore": "workspace:^",
    "spessasynth_core": "4.4.9"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@lobehub/fluent-emoji": "^5.0.1",
    "@lobehub/icons": "^6.15.0",
    "@lobehub/ui": "6.15.2",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "lucide-react": "^1.71.0",
    "motion": "^14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.7"
  }
}
